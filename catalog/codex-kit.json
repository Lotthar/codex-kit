{
  "schemaVersion": 1,
  "minimumNodeVersion": 20,
  "platforms": ["linux"],
  "presets": {
    "minimal": ["base-policy"],
    "developer": ["base-policy", "ponytail", "ruflo", "graphify", "promptx", "clean-code"],
    "personal": ["base-policy", "ponytail", "ruflo", "promptx", "clean-code"]
  },
  "components": {
    "base-policy": { "kind": "policy", "scope": ["global", "project"], "source": "policies/global.md" },
    "ponytail": { "kind": "plugin", "scope": ["global", "project"], "plugin": "ponytail@ponytail", "version": "4.8.4" },
    "ruflo": { "kind": "mcp", "scope": ["global"], "command": "npx", "args": ["-y", "ruflo@3.28.0", "mcp", "start"], "approvalMode": "writes" },
    "graphify": { "kind": "project-tool", "scope": ["project"], "version": "0.9.11", "legacyPath": "setup-graphify-codex.mjs" },
    "promptx": { "kind": "project-tool", "scope": ["project"], "legacyPath": "promptx/setup-codex-prompt-enhancer.mjs" },
    "clean-code": { "kind": "project-tool", "scope": ["project"], "legacyPath": "continuous-clean-code-refactor/SKILL.md" }
  },
  "portableSources": ["AGENTS.md", "skills"]
}
